    @template local_interactembedcreator/guide

    Localized user guide.

    Context variables required for this template:
    * libraryurl, intro (string): library link and introduction.
    * steps (array): title and body (string) for each guide step.

    Example context (json):
    {
        "libraryurl": "/local/interactembedcreator/index.php",
        "intro": "Create, publish and reuse interactive content.",
        "steps": [{"title": "Create", "body": "Start from a template."}]
    }
}}
<article class="iec-guide">
    <a class="btn btn-link" href="{{libraryurl}}">← {{#str}}backtolibrary, local_interactembedcreator{{/str}}</a>
    <header>
        <p class="iec-eyebrow">{{#str}}pluginname, local_interactembedcreator{{/str}}</p>
        <h2>{{#str}}guide, local_interactembedcreator{{/str}}</h2>
        <p>{{intro}}</p>
    </header>
    <div class="iec-guide__steps">
        {{#steps}}
        <section>
            <h3>{{title}}</h3>
            <p>{{body}}</p>
        </section>
        {{/steps}}
    </div>
</article>
